Cell[TextData[{
 StyleBox["Here, each crossing point\[CloseCurlyQuote]s information is stored \
in a 7-tuple {curve1proj[i], curve2proj[j], curve1proj[i + 1], curve2proj[j + \
1], i, j, inter} such that:\n\n1.) The first four values are the projected \
co-ordinates of curve1 and curve2 between which the crossing is found, \n2.) \
The next two values in the tuple is the position of these co-ordinates in the \
list, \n3.) The last value in the tuple is the co-ordinates of the actual \
crossing.\n\nNote that, this list also contains the end-matched point, we \
want to exclude it from this list for now. This is because this crossing does \
not contribute to ",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         SubsuperscriptBox[
          StyleBox["r", "TI"], "1", "\[Iota]\[Tau]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Cr^{\\iota\\tau}_{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[0.6235294117647059, 0., 0.],ExpressionUUID->
  "b0ba4c32-4c42-4de6-bb4b-507a02241b63"],
 StyleBox[" or ",
  FontWeight->"Bold",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["C", "TI"], 
          SubsuperscriptBox[
           StyleBox["r", "TI"], "2", "\[Iota]\[Tau]"]}], TraditionalForm], 
      "errors" -> {}, "input" -> "Cr^{\\iota\\tau}_{2}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "."}], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[0.6235294117647059, 0., 0.],ExpressionUUID->
  "9a0e3db4-cdc6-47d2-9b20-81ec18e21c2a"]
}], "Text",
 CellChangeTimes->{{3.9719115873474755`*^9, 3.9719116228962193`*^9}, {
