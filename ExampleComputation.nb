Cell[TextData[{
 StyleBox["Next, to find whether a crossing contributes to ",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         SubsuperscriptBox[
          StyleBox["r", "TI"], "1", "\[Iota]\[Tau]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Cr^{\\iota\\tau}_{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[0.6235294117647059, 0., 0.],ExpressionUUID->
  "f9e9d6c7-7c33-453f-af6d-93246d4f1675"],
 StyleBox[" or ",
  FontWeight->"Bold",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         SubsuperscriptBox[
          StyleBox["r", "TI"], "2", "\[Iota]\[Tau]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Cr^{\\iota\\tau}_{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[0.6235294117647059, 0., 0.],ExpressionUUID->
  "263bbf6d-ad6e-4099-86b4-466982365592"],
 StyleBox[", we find the points on the original curve which map to the \
intersection point in the projection.",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]]
}], "Text",
