Cell[TextData[{
 StyleBox["For the purpose of computation, we\[CloseCurlyQuote]ll consider \
the end-matching of the terminal point of curve2 onto the initial point of \
curve1. The projection plane is assumed to be far away from the curves. To \
implement this, we rescale the co-ordinates by the highest x,y,z coordinate \
value amongst the given curve1 and curve2 co-ordinates. This ensures that the \
co-ordinates are at most ",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SqrtBox["3"], TraditionalForm], "errors" -> {}, "input" -> "\\sqrt{3}",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontVariations->{"Underline"->False},
  FontColor->RGBColor[0.6235294117647059, 0., 0.],ExpressionUUID->
  "db3942c3-99d3-41d5-a351-45d2e870999d"],
 StyleBox[" distance away from the origin. The projection plane is also \
placed such that the shortest distance from origin is ",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SqrtBox["3"], "+", "1"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sqrt{3}+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontVariations->{"Underline"->False},
  FontColor->RGBColor[0.6235294117647059, 0., 0.],ExpressionUUID->
  "dde10b9f-6ae6-4fa7-b6e4-443dcefb9048"],
 StyleBox[".  This is illustrated below:",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]]
}], "Text",
 CellChangeTimes->{{3.9718985726776047`*^9, 3.9718986152505636`*^9}, {
  3.9719072118897424`*^9, 3.9719072133684187`*^9}, {3.9719072585879793`*^9, 
  3.971907286716959*^9}, {3.971913171106336*^9, 3.9719132059963636`*^9}, {
  3.979253206961944*^9, 
  3.97925320720477*^9}},ExpressionUUID->"c49d1df6-4405-4608-be43-\
36887153b95c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"sf", "=", 
  RowBox[{"Scalingfactor", "[", 
   RowBox[{"curve1", ",", " ", "curve2"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"curve1", "=", 
  RowBox[{"curve1", "/", "sf"}]}], "\[IndentingNewLine]", 
 RowBox[{"curve2", "=", 
  RowBox[{"curve2", "/", "sf"}]}]}], "Input",
