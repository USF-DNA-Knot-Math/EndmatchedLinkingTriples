Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cr1plot", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cr2plot", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"cr1plot", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"curve1proj", "[", 
         RowBox[{"[", 
          RowBox[{"crossings", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "5"}], "]"}], "]"}], "]"}], "]"}], ",", " ", 
        RowBox[{"curve1proj", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"crossings", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "5"}], "]"}], "]"}], "+", "1"}], "]"}], 
         "]"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "crossings", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"cr2plot", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"curve2proj", "[", 
         RowBox[{"[", 
          RowBox[{"crossings", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "6"}], "]"}], "]"}], "]"}], "]"}], ",", " ", 
        RowBox[{"curve2proj", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"crossings", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "6"}], "]"}], "]"}], "+", "1"}], "]"}], 
         "]"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "crossings", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"CurveProjectionCoordplot", "[", 
    RowBox[{"curve1proj", ",", "projplane", ",", " ", "Orange"}], "]"}], ",", 
   " ", 
   RowBox[{"CurveProjectionCoordplot", "[", 
    RowBox[{"curve2proj", ",", " ", "projplane", ",", " ", "Blue"}], "]"}], 
   ",", 
   RowBox[{"ListLinePlot3D", "[", 
    RowBox[{"curve1", ",", " ", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Orange", ",", " ", "Dashed"}], "}"}]}]}], "]"}], ",", 
   RowBox[{"ListLinePlot3D", "[", 
    RowBox[{"curve2", ",", " ", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", " ", "Dashed"}], "}"}]}]}], "]"}], ",", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ListPointPlot3D", "[", 
      RowBox[{"ogpoints", "[", 
