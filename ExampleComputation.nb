Cell[TextData[StyleBox["Defining crossing vectors and determining the angle \
between the vectors at each crossing",
 FontWeight->"Bold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.6235294117647059, 0., 0.]]], "Text",
 CellChangeTimes->{
  3.9719159967606*^9},ExpressionUUID->"0a465088-20ed-4194-8cdd-a870168d8103"],

Cell[BoxData[
 RowBox[{
  RowBox[{"crossingvectors", "=", " ", 
   RowBox[{
    RowBox[{"Reap", "[", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Sow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"crossings", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "3"}], "]"}], "]"}], "-", 
           RowBox[{"crossings", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"crossings", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "4"}], "]"}], "]"}], "-", 
           RowBox[{"crossings", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"VectorAngle", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"crossings", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "3"}], "]"}], "]"}], "-", 
             RowBox[{"crossings", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"crossings", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "4"}], "]"}], "]"}], "-", 
             RowBox[{"crossings", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}]}]}], "]"}]}], "}"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "crossings", "]"}]}], "}"}]}], "]"}], "]"}], 
    "[", 
    RowBox[{"[", 
     RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[201]:=",ExpressionUUID->"ab710abd-f90a-4c3a-b3ab-850f8d22b9d2"],

Cell[TextData[{
 StyleBox["Determining the position of each triple of crossings vectors and \
vector angle in the Linking triple based on whether a crossing contributes to \
",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         SubsuperscriptBox[
          StyleBox["r", "TI"], "1", "\[Iota]\[Tau]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Cr^{\\iota\\tau}_{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[0.6235294117647059, 0., 0.],ExpressionUUID->
  "343d00ed-da72-45f9-8967-e1f85f694f37"],
 StyleBox[" or ",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         SubsuperscriptBox[
          StyleBox["r", "TI"], "2", "\[Iota]\[Tau]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Cr^{\\iota\\tau}_{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[0.6235294117647059, 0., 0.],ExpressionUUID->
  "5a085a81-879b-4a69-b96b-1e1d929feebe"],
 StyleBox[".",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]]
}], "Text",
 CellChangeTimes->{
  3.9719159967606*^9, {3.9719160937544885`*^9, 
   3.9719161355584445`*^9}},ExpressionUUID->"67c4a551-9667-47d2-bf5c-\
6b4f11451394"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tuplepos", "=", 
   RowBox[{"Reap", "[", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Dot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ogpoints", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
             RowBox[{"ogpoints", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", "dirVec"}], 
           "]"}], ">", "0"}], ",", " ", 
         RowBox[{"Sow", "[", 
          RowBox[{
           RowBox[{"crossingvectors", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"{", "x", "}"}]}], "]"}], ",", 
         RowBox[{"Sow", "[", 
          RowBox[{
           RowBox[{"crossingvectors", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"{", "y", "}"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", 
         RowBox[{"Length", "[", "crossings", "]"}]}], "}"}]}], " ", "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.97191614976783*^9, 3.971916162286641*^9}},
 CellLabel->
  "In[202]:=",ExpressionUUID->"b21d9826-7bb6-4bf5-afa7-c2952a3678d0"],

Cell[TextData[StyleBox["Checking if there are any crossings in each tuple \
position:",
 FontWeight->"Bold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.6235294117647059, 0., 0.]]], "Text",
 CellChangeTimes->{{3.9719161853530836`*^9, 
  3.971916202850066*^9}},ExpressionUUID->"270fc10d-0722-45f9-89c9-\
41a8aaf2d224"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"tuplepos", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}], ">", " ", "0"}], ",", 
    " ", 
    RowBox[{"cr1crossings", "=", 
     RowBox[{"tuplepos", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1", ",", "1"}], "]"}], "]"}]}], ",", " ", 
    RowBox[{"cr1crossings", "=", 
     RowBox[{"{", "}"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"tuplepos", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "2"}], "]"}], "]"}], "]"}], ">", "0"}], ",", " ", 
    RowBox[{"cr2crossings", "=", 
     RowBox[{"tuplepos", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "2", ",", "1"}], "]"}], "]"}]}], ",", " ", 
    RowBox[{"cr2crossings", "=", 
     RowBox[{"{", "}"}]}]}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[203]:=",ExpressionUUID->"891d5fe6-9672-44a8-9a8b-691334fda43d"],

Cell[TextData[StyleBox["To find the crossing sign for each crossing:",
 FontWeight->"Bold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.6235294117647059, 0., 0.]]], "Text",
 CellChangeTimes->{{3.97191623336285*^9, 
  3.971916239970186*^9}},ExpressionUUID->"fbaf4904-54fe-4447-916a-\
c58528dfe502"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "cr1crossings", "]"}], ">", "0"}], ",", "\n", 
    RowBox[{"cr1crossinginfo", "=", " ", 
     RowBox[{
      RowBox[{"Reap", "[", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Dot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"RotationTransform", "[", 
                 RowBox[{
                  RowBox[{"cr1crossings", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "3"}], "]"}], "]"}], ",", "dirVec"}], 
                 "]"}], "[", 
                RowBox[{"cr1crossings", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], ",", " ", 
               RowBox[{"cr1crossings", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "-", 
             RowBox[{"Dot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"RotationTransform", "[", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"cr1crossings", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ",", "dirVec"}], 
                 "]"}], "[", 
                RowBox[{"cr1crossings", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], ",", " ", 
               RowBox[{"cr1crossings", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}]}], ">", " ", 
            "0"}], ",", " ", 
           RowBox[{"Sow", "[", 
            RowBox[{"-", "1"}], "]"}], ",", " ", 
           RowBox[{"Sow", "[", "1", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", "cr1crossings", "]"}]}], "}"}]}], "]"}], 
       "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", 
    RowBox[{"cr1crossinginfo", "=", 
     RowBox[{"{", "0", "}"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "cr2crossings", "]"}], ">", "0"}], ",", "\n", 
    RowBox[{"cr2crossinginfo", "=", " ", 
     RowBox[{
      RowBox[{"Reap", "[", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Dot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"RotationTransform", "[", 
                 RowBox[{
                  RowBox[{"cr2crossings", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "3"}], "]"}], "]"}], ",", "dirVec"}], 
                 "]"}], "[", 
                RowBox[{"cr2crossings", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], ",", " ", 
               RowBox[{"cr2crossings", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], "-", 
             RowBox[{"Dot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"RotationTransform", "[", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"cr2crossings", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ",", "dirVec"}], 
                 "]"}], "[", 
                RowBox[{"cr2crossings", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], ",", " ", 
               RowBox[{"cr2crossings", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}]}], ">", "0"}],
            ",", " ", 
           RowBox[{"Sow", "[", 
            RowBox[{"-", "1"}], "]"}], ",", " ", 
           RowBox[{"Sow", "[", "1", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", "cr2crossings", "]"}]}], "}"}]}], "]"}], 
       "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", " ", 
    RowBox[{"cr2crossinginfo", "=", 
     RowBox[{"{", "0", "}"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cr1", "=", " ", 
   RowBox[{"Total", "[", "cr1crossinginfo", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cr2", "=", " ", 
   RowBox[{"Total", "[", "cr2crossinginfo", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.971916319225296*^9, 3.97191634844265*^9}, {
  3.971916526111332*^9, 3.97191652688861*^9}},
 CellLabel->
  "In[205]:=",ExpressionUUID->"b1d50a4e-c479-47cf-bf0e-5d910426ae0b"],

Cell[TextData[StyleBox["Finally, we compute the end-matched linking number:",
 FontWeight->"Bold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.6235294117647059, 0., 0.]]], "Text",
 CellChangeTimes->{{3.9719161853530836`*^9, 3.971916202850066*^9}, {
  3.971916370683444*^9, 
  3.9719163858906436`*^9}},ExpressionUUID->"1d97c93e-8723-4a73-9d70-\
20338bde8ca8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"endcrvec1", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"p1", "==", 
      RowBox[{"curve1", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"curve1proj", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "-", 
      RowBox[{"curve1proj", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"curve1proj", "[", 
       RowBox[{"[", 
        RowBox[{"Length", "[", "curve1proj", "]"}], "]"}], "]"}], "-", " ", 
      RowBox[{"curve1proj", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"Length", "[", "curve1proj", "]"}], "-", "1"}], "]"}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"endcrvec2", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"p2", "==", 
      RowBox[{"curve2", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"curve2proj", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "-", 
      RowBox[{"curve2proj", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"curve2proj", "[", 
       RowBox[{"[", 
        RowBox[{"Length", "[", "curve2proj", "]"}], "]"}], "]"}], "-", " ", 
      RowBox[{"curve2proj", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"Length", "[", "curve2proj", "]"}], "-", "1"}], "]"}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vecang", "=", 
   RowBox[{"VectorAngle", "[", 
    RowBox[{"endcrvec1", ",", "endcrvec2"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"endmatched", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RotationTransform", "[", 
           RowBox[{"vecang", ",", "dirVec"}], "]"}], "[", "endcrvec1", "]"}], 
         ",", " ", "endcrvec2"}], "]"}], "-", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RotationTransform", "[", 
           RowBox[{
            RowBox[{"-", "vecang"}], ",", "dirVec"}], "]"}], "[", "endcrvec1",
           "]"}], ",", " ", "endcrvec2"}], "]"}]}], ">", "0"}], ",", " ", 
     RowBox[{"-", "1"}], ",", "1"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.971916480169094*^9, 3.9719165002314587`*^9}},
 CellLabel->
  "In[209]:=",ExpressionUUID->"7cbd6c3a-fe90-49e0-b8b3-655fa19e92dc"],

Cell[TextData[StyleBox["Thus, the linking triple is obtained as:",
 FontWeight->"Bold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.6235294117647059, 0., 0.]]], "Text",
 CellChangeTimes->{{3.9719161853530836`*^9, 3.971916202850066*^9}, {
  3.971916370683444*^9, 3.9719163858906436`*^9}, {3.971916540308494*^9, 
  3.971916552558591*^9}},ExpressionUUID->"858c9304-27b6-4b25-b7f9-\
632ff505c994"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"cr1", ",", "cr2", ",", "endmatched"}], "}"}]], "Input",
 CellChangeTimes->{{3.9719165601039715`*^9, 3.9719165689511137`*^9}},
 CellLabel->
  "In[213]:=",ExpressionUUID->"02a912ef-84ca-4c25-be88-91d44660b217"],

