Cell[TextData[{
 StyleBox["Using these projected co-ordinates, we mark the crossings/double \
points. We need these to compute  ",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0.6235294117647059, 0., 0.]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         SubsuperscriptBox[
          StyleBox["r", "TI"], "1", "\[Iota]\[Tau]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Cr^{\\iota\\tau}_{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[0.6235294117647059, 0., 0.],ExpressionUUID->
  "8795a6ca-89ce-4dae-b61b-868962cc2f30"],
