    RowBox[{
     RowBox[{"Graphics3D", "[", 
      RowBox[{"InfiniteLine", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ogpoints", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", " ", 
         RowBox[{"ogpoints", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
