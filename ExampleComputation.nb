Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nulllist", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"omit1", "=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"p1", "==", "ini1"}], ",", " ", "1", ",", " ", 
     RowBox[{"p1", "==", "term1"}], ",", " ", 
     RowBox[{
      RowBox[{"Length", "[", "curve1", "]"}], "-", "1"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"omit2", "=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"p2", "==", "ini2"}], ",", " ", "1", ",", " ", 
     RowBox[{"p2", "==", "term2"}], ",", " ", 
     RowBox[{
      RowBox[{"Length", "[", "curve2", "]"}], "-", "1"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"crlist", "[", 
         RowBox[{"[", 
          RowBox[{"l", ",", "5"}], "]"}], "]"}], "==", " ", "omit1"}], "&&", 
       RowBox[{
        RowBox[{"crlist", "[", 
         RowBox[{"[", 
          RowBox[{"l", ",", "6"}], "]"}], "]"}], "==", "omit2"}]}], ",", " ", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"nulllist", ",", " ", 
        RowBox[{"crlist", "[", 
         RowBox[{"[", "l", "]"}], "]"}]}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"l", ",", " ", "1", ",", " ", 
      RowBox[{"Length", "[", "crlist", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"crossings", "=", 
  RowBox[{"DeleteElements", "[", 
   RowBox[{"crlist", ",", " ", "nulllist"}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{
