Cell[TextData[StyleBox["For a finite set of curves, we just need to list all \
the curves. The function iteratively computes for all pairs of curves. For \
instance:",
 FontWeight->"Bold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.6235294117647059, 0., 0.]]], "Text",
 CellChangeTimes->{{3.9719161853530836`*^9, 3.971916202850066*^9}, {
  3.971916370683444*^9, 3.9719163858906436`*^9}, {3.971916540308494*^9, 
  3.971916552558591*^9}, {3.9719165841612883`*^9, 3.9719166118013687`*^9}, {
  3.971916670449771*^9, 3.97191669388715*^9}, {3.971916770176936*^9, 
  3.9719167861853666`*^9}},ExpressionUUID->"66a320c1-6584-4e22-b8e6-\
c6b867267450"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"listofchains", "=", 
   RowBox[{"{", 
    RowBox[{"a", ",", "c", ",", "d", ",", "n"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"triplesarray", "=", 
  RowBox[{
  "Computelinkingtriplesendmatched", "[", "listofchains", "]"}]}]}], "Input",
 CellChangeTimes->{{3.971916700815321*^9, 3.9719167189712877`*^9}, {
